{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/repo-policy.schema.json",
  "title": "Simple Changes repository policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "guidance",
    "defaultFinish",
    "questions",
    "review",
    "productionDeploy",
    "concurrentWork"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "disposition": {
          "enum": ["accepted", "reviewed", "deferred"]
        },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "defaultFinish": {
      "enum": ["open-change-request", "integrate", "ship", "preview"]
    },
    "gitPushAuthorization": {
      "enum": ["configure-harness", "ask", "never"]
    },
    "changelogHandling": {
      "enum": ["delegate-if-available", "preserve-and-report", "ask"]
    },
    "handoffTiming": {
      "enum": ["confirm-ready", "automatic", "user-signaled"]
    },
    "migrationHandling": {
      "enum": [
        "ask-after-review",
        "auto-apply-reviewed-routine",
        "auto-apply-reviewed",
        "never"
      ]
    },
    "migrationTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "project", "environment"],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "uiArtifactVersioning": {
      "enum": [
        "repository-convention",
        "number-and-date",
        "date-only",
        "number-only"
      ]
    },
    "questions": {
      "enum": ["blocking-only", "always", "never"]
    },
    "review": {
      "enum": ["repository-policy", "independent", "provider-policy"]
    },
    "productionDeploy": {
      "enum": ["ask", "allow", "deny"]
    },
    "shippingMode": {
      "enum": ["standard", "expedited", "break-glass"]
    },
    "concurrentWork": {
      "enum": ["allow-claimed", "strict", "preserve"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "migrationHandling": {
            "enum": ["auto-apply-reviewed-routine", "auto-apply-reviewed"]
          }
        },
        "required": ["migrationHandling"]
      },
      "then": {
        "properties": {
          "migrationTargets": { "minItems": 1 }
        },
        "required": ["migrationTargets"]
      }
    }
  ]
}
