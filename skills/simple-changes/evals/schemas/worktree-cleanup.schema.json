{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/worktree-cleanup.schema.json",
  "title": "Simple Changes standalone worktree cleanup receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cleanupId",
    "agentId",
    "approvedBy",
    "reason",
    "recordedAt",
    "targetRef",
    "targetRevision",
    "removed",
    "prunedPaths",
    "preserved",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "cleanupId": {
      "type": "string",
      "pattern": "^cleanup-[0-9a-f-]{36}$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetRef": {
      "type": "string",
      "minLength": 1
    },
    "targetRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "branch",
          "branchDeleted",
          "headSha",
          "changeDigest",
          "containment"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "branchDeleted": {
            "type": "boolean"
          },
          "headSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "changeDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "containment": {
            "enum": ["target-contained", "patch-equivalent"]
          }
        }
      }
    },
    "prunedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preserved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "nextCommand"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "nextCommand": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phase": {
      "enum": ["intent", "completed"]
    },
    "plannedRemovals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "branch",
          "headSha",
          "changeDigest",
          "containment"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "branch": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
          "changeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "containment": { "enum": ["target-contained", "patch-equivalent"] }
        }
      }
    },
    "plannedPrunePaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": 2 } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["phase", "plannedRemovals", "plannedPrunePaths"]
      }
    }
  ]
}
