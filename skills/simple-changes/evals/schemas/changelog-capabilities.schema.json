{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/changelog-capabilities.schema.json",
  "title": "Simple Changelogs integration capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "distribution",
    "guidanceVersion",
    "requestVersions",
    "receiptVersions",
    "features"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "const": "simple-changelogs" },
    "distribution": { "type": "string", "minLength": 1 },
    "guidanceVersion": { "type": "integer", "minimum": 1 },
    "requestVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "receiptVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "description": "Known values: public-version-policy, classify-prepare-verify, multi-train-receipts, guidance-update-notices, shared-version-lines. Since Simple Changes 0.23.0 an unrecognized value is ignored during negotiation, so a provider may advertise a newer feature without breaking this consumer; consumers before 0.23.0 reject any value outside the first four.",
      "items": { "type": "string", "minLength": 1 }
    },
    "schemaDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changelogRequest", "changelogReceipt"],
      "properties": {
        "changelogRequest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "changelogReceipt": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
