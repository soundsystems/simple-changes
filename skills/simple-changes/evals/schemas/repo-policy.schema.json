{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/repo-policy.schema.json",
  "title": "Simple Changes repository policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "guidance",
    "defaultFinish",
    "questions",
    "review",
    "productionDeploy",
    "concurrentWork"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "disposition": {
          "enum": ["accepted", "reviewed", "deferred"]
        },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "defaultFinish": {
      "enum": ["open-change-request", "integrate", "ship", "preview"]
    },
    "changelogHandling": {
      "enum": ["delegate-if-available", "preserve-and-report", "ask"]
    },
    "handoffTiming": {
      "enum": ["confirm-ready", "automatic", "user-signaled"]
    },
    "uiArtifactVersioning": {
      "enum": [
        "repository-convention",
        "number-and-date",
        "date-only",
        "number-only"
      ]
    },
    "questions": {
      "enum": ["blocking-only", "always", "never"]
    },
    "review": {
      "enum": ["repository-policy", "independent", "provider-policy"]
    },
    "productionDeploy": {
      "enum": ["ask", "allow", "deny"]
    },
    "shippingMode": {
      "enum": ["standard", "expedited", "break-glass"]
    },
    "concurrentWork": {
      "enum": ["allow-claimed", "strict", "preserve"]
    }
  }
}
