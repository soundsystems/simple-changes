{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.local/schemas/migration-apply-plan.schema.json",
  "title": "Exact Migration Apply Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter",
    "command",
    "digest",
    "expiresAt",
    "issuedAt",
    "nonce",
    "operations",
    "remoteLedger",
    "scope",
    "target"
  ],
  "properties": {
    "adapter": { "type": "string", "minLength": 1, "maxLength": 128 },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 256 },
    "target": { "$ref": "#/$defs/target" },
    "remoteLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "observedAt", "operations", "target"],
      "properties": {
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observedAt": { "type": "string", "format": "date-time" },
        "operations": { "$ref": "#/$defs/operations" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "scope": { "const": "exact-listed-operations" },
    "operations": { "$ref": "#/$defs/operations" }
  },
  "$defs": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contentDigest", "revision"],
        "properties": {
          "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "project", "environment"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "project": { "type": "string", "minLength": 1, "maxLength": 256 },
        "environment": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
