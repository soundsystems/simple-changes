{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/initialization.schema.json",
  "title": "Simple Changes initialization status",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "authoringQuestionState": {
      "enum": ["pending", "answered", "repair", "not-applicable"]
    },
    "authoringFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "errors"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "state": { "enum": ["absent", "valid", "malformed"] },
        "errors": { "type": "array", "items": { "type": "string" } },
        "value": {
          "description": "The validated sidecar (authoring.schema.json), present only when state is valid.",
          "type": "object"
        }
      }
    },
    "authoringRoleFields": {
      "type": "object",
      "required": ["effort", "harness", "model", "status"],
      "properties": {
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
        "harness": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "model": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["resolved", "most-capable", "unresolved", "no-delegation"]
        }
      }
    },
    "authoringRole": {
      "allOf": [
        { "$ref": "#/$defs/authoringRoleFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effort", "harness", "model", "status"],
          "properties": {
            "effort": {},
            "harness": {},
            "model": {},
            "status": {}
          }
        }
      ]
    },
    "authoringSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effort", "harness", "model", "path"],
      "properties": {
        "effort": { "$ref": "#/$defs/authoringLayer" },
        "harness": { "$ref": "#/$defs/authoringLayer" },
        "model": { "$ref": "#/$defs/authoringLayer" },
        "path": { "anyOf": [{ "type": "null" }, { "type": "string" }] }
      }
    },
    "authoringLayer": { "enum": ["repository", "personal", "default"] },
    "guidanceQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choices", "id", "question", "reason", "setting"],
      "properties": {
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "label", "recommended", "value"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "recommended": { "type": "boolean" },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        },
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "setting": { "type": "string", "minLength": 1 }
      }
    }
  },
  "required": [
    "mode",
    "changelogRequired",
    "changelogCoordination",
    "firstUseWalkthroughAvailable",
    "gitPushAuthorization",
    "guidanceUpdate",
    "handoffAction",
    "handoffClaimRelease",
    "handoffTiming",
    "writeCapable",
    "mutationAllowed",
    "onboardingRequired",
    "policySource",
    "policyPath",
    "policyTrust",
    "inferredDefaultFinish",
    "migrationHandling",
    "migrationTargets",
    "readinessConfirmed",
    "preLoopActionRequired",
    "resolvedMode",
    "shippingMode",
    "reason"
  ],
  "properties": {
    "gitPushAuthorization": {
      "enum": ["configure-harness", "ask", "never"]
    },
    "guidanceUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionDescriptions",
        "actions",
        "changelogHandoff",
        "changes",
        "currentVersion",
        "headline",
        "presentationOrder",
        "recommendedChanges",
        "releaseNotes",
        "recommendedAction",
        "requiredAnswers",
        "status",
        "storedDisposition",
        "storedVersion",
        "summaryBullets",
        "walkthroughQuestion"
      ],
      "properties": {
        "actionDescriptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review-settings",
            "expanded-walkthrough",
            "keep-current-settings",
            "defer",
            "view-release-notes",
            "review-with-simple-changelogs"
          ],
          "properties": {
            "review-settings": { "type": "string", "minLength": 1 },
            "expanded-walkthrough": { "type": "string", "minLength": 1 },
            "keep-current-settings": { "type": "string", "minLength": 1 },
            "defer": { "type": "string", "minLength": 1 },
            "view-release-notes": { "type": "string", "minLength": 1 },
            "review-with-simple-changelogs": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "review-settings",
              "expanded-walkthrough",
              "keep-current-settings",
              "defer",
              "view-release-notes",
              "review-with-simple-changelogs"
            ]
          }
        },
        "changelogHandoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "owner", "reason"],
          "properties": {
            "available": { "type": "boolean" },
            "owner": {
              "anyOf": [{ "const": "simple-changelogs" }, { "type": "null" }]
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "summary", "version"],
            "properties": {
              "kind": { "enum": ["behavior", "onboarding", "integration"] },
              "summary": { "type": "string", "minLength": 1 },
              "version": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "currentVersion": { "type": "integer", "minimum": 1 },
        "headline": {
          "const": "**Simple Changes has recently been updated.**"
        },
        "presentationOrder": {
          "type": "array",
          "const": [
            "required-answers",
            "recommended-changes",
            "summary",
            "actions"
          ]
        },
        "recommendedChanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/guidanceQuestion" }
        },
        "releaseNotes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "command", "label"],
          "properties": {
            "available": { "const": true },
            "command": { "const": "simple-changes release-notes" },
            "label": {
              "const": "View detailed Simple Changes release notes"
            }
          }
        },
        "recommendedAction": {
          "anyOf": [
            {
              "enum": [
                "review-settings",
                "expanded-walkthrough",
                "keep-current-settings",
                "defer",
                "view-release-notes",
                "review-with-simple-changelogs"
              ]
            },
            { "type": "null" }
          ]
        },
        "requiredAnswers": {
          "type": "array",
          "items": { "$ref": "#/$defs/guidanceQuestion" }
        },
        "status": { "enum": ["current", "update-available"] },
        "storedDisposition": {
          "anyOf": [
            { "enum": ["accepted", "reviewed", "deferred"] },
            { "type": "null" }
          ]
        },
        "storedVersion": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "summaryBullets": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "walkthroughQuestion": {
          "const": "How would you like to continue?"
        }
      }
    },
    "changelogInstall": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "decision", "distribution", "offered"],
          "properties": {
            "command": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "decision": {
              "anyOf": [
                {
                  "enum": [
                    "install-now",
                    "install-after-shipment",
                    "install-later",
                    "declined"
                  ]
                },
                { "type": "null" }
              ]
            },
            "distribution": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "offered": { "type": "boolean" }
          }
        }
      ]
    },
    "changelogCoordination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevant",
        "capabilityAvailable",
        "capabilityHelpers",
        "capabilityStatus",
        "guidanceUpdate",
        "releaseSurfaces",
        "providers",
        "providerDistribution",
        "providerEvidence"
      ],
      "properties": {
        "relevant": { "type": "boolean" },
        "capabilityAvailable": { "type": "boolean" },
        "providerDistribution": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "providerEvidence": { "enum": ["marker", "inferred", "none"] },
        "capabilityHelpers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilityStatus": {
          "enum": ["absent", "not-applicable", "unverified"]
        },
        "guidanceUpdate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actions",
            "detailsPath",
            "headline",
            "installedVersion",
            "owner",
            "policyPath",
            "provider",
            "status",
            "storedVersion",
            "summaryBullets",
            "walkthroughQuestion"
          ],
          "properties": {
            "actions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["walkthrough", "continue", "view-release-notes"]
              }
            },
            "detailsPath": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "headline": {
              "const": "**Simple Changelogs has recently been updated.**"
            },
            "installedVersion": {
              "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
            },
            "owner": {
              "anyOf": [{ "const": "simple-changelogs" }, { "type": "null" }]
            },
            "policyPath": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "provider": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "status": {
              "enum": [
                "absent",
                "unconfigured",
                "current",
                "update-available",
                "unknown"
              ]
            },
            "storedVersion": {
              "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
            },
            "summaryBullets": {
              "type": "array",
              "maxItems": 3,
              "items": { "type": "string", "minLength": 1 }
            },
            "walkthroughQuestion": {
              "const": "Would you like me to walk you through the recent Simple Changelogs updates before I continue?"
            }
          }
        },
        "releaseSurfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mode": {
      "enum": [
        "preview",
        "sync",
        "queue",
        "sweep",
        "integrate",
        "ship",
        "reconcile",
        "resume",
        "pause",
        "handoff"
      ]
    },
    "handoffAction": {
      "enum": [
        "not-applicable",
        "confirm-readiness",
        "wait-for-user",
        "proceed"
      ]
    },
    "handoffClaimRelease": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimId", "path"],
          "properties": {
            "claimId": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "handoffTiming": {
      "anyOf": [
        { "enum": ["confirm-ready", "automatic", "user-signaled"] },
        { "type": "null" }
      ]
    },
    "writeCapable": { "type": "boolean" },
    "firstUseWalkthroughAvailable": { "type": "boolean" },
    "changelogRequired": { "type": "boolean" },
    "mutationAllowed": { "type": "boolean" },
    "onboardingRequired": { "type": "boolean" },
    "policySource": { "enum": ["default", "user", "repository"] },
    "policyPath": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "policyTrust": { "enum": ["not-required", "trusted", "untrusted"] },
    "inferredDefaultFinish": {
      "anyOf": [
        { "enum": ["open-change-request", "integrate", "ship"] },
        { "type": "null" }
      ]
    },
    "migrationHandling": {
      "enum": [
        "ask-after-review",
        "auto-apply-reviewed-routine",
        "auto-apply-reviewed",
        "never"
      ]
    },
    "migrationTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "project", "environment"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 }
        }
      }
    },
    "readinessConfirmed": { "type": "boolean" },
    "preLoopActionRequired": { "type": "boolean" },
    "resolvedMode": {
      "anyOf": [
        {
          "enum": [
            "preview",
            "sync",
            "queue",
            "sweep",
            "integrate",
            "ship",
            "reconcile",
            "resume",
            "pause"
          ]
        },
        { "type": "null" }
      ]
    },
    "shippingMode": {
      "enum": ["standard", "expedited", "break-glass"]
    },
    "productionDeploy": {
      "description": "Effective after the repository trust downgrade; present from 0.23.1, so an absent value means an older runtime.",
      "enum": ["ask", "allow", "deny"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "runtimeFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "path",
        "runningVersion",
        "status",
        "targetRef",
        "targetVersion"
      ],
      "properties": {
        "message": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "runningVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["current", "behind-target", "not-applicable"] },
        "targetRef": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "targetVersion": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "detectedHarnesses": {
      "description": "Read-only detection from agents/harnesses.json: a running session variable or a home-directory root that exists.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "authoringFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "personal"],
      "properties": {
        "repository": { "$ref": "#/$defs/authoringFile" },
        "personal": { "$ref": "#/$defs/authoringFile" }
      }
    },
    "authoringQuestion": {
      "description": "Per question, from validated sidecars and current detection; never from the guidance acknowledgement.",
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "review"],
      "properties": {
        "models": { "$ref": "#/$defs/authoringQuestionState" },
        "review": { "$ref": "#/$defs/authoringQuestionState" }
      }
    },
    "authoringReviewQuestion": {
      "description": "The independent-review question to ask while authoringQuestion.review is pending, whatever the guidance version.",
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/guidanceQuestion" }]
    },
    "authoring": {
      "description": "Effective authoring roles with each field's layer and the file of the highest layer that supplied any field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["effective", "source"],
      "properties": {
        "effective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposals", "review"],
          "properties": {
            "proposals": { "$ref": "#/$defs/authoringRole" },
            "review": {
              "allOf": [
                { "$ref": "#/$defs/authoringRoleFields" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "effort",
                    "harness",
                    "model",
                    "status",
                    "adversarial",
                    "escalateOnFindings"
                  ],
                  "properties": {
                    "effort": {},
                    "harness": {},
                    "model": {},
                    "status": {},
                    "adversarial": { "type": "boolean" },
                    "escalateOnFindings": { "enum": ["high", "xhigh", null] }
                  }
                }
              ]
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposals", "review"],
          "properties": {
            "proposals": { "$ref": "#/$defs/authoringSource" },
            "review": { "$ref": "#/$defs/authoringSource" }
          }
        }
      }
    },
    "reviewer": {
      "description": "The review role resolved before dispatch: provisional without --proposal/--head, verified against that head's effective authors with them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adversarial",
        "effort",
        "effortSource",
        "harness",
        "mode",
        "model",
        "proposal",
        "reason",
        "status"
      ],
      "properties": {
        "adversarial": { "type": "boolean" },
        "effort": {
          "anyOf": [
            { "type": "null" },
            { "enum": ["low", "medium", "high", "xhigh", "max"] }
          ]
        },
        "effortSource": { "enum": ["configured", "escalation", null] },
        "harness": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" }
          ]
        },
        "mode": { "enum": ["provisional", "verified"] },
        "model": {
          "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "reason": {
          "enum": [
            null,
            "authoring-repair",
            "author-identity-missing",
            "authors-not-recorded",
            "coverage-incomplete",
            "ledger-cycle",
            "ledger-malformed",
            "most-capable-unresolved",
            "no-delegation",
            "no-effective-authors",
            "reviewer-not-distinct",
            "running-harness-unknown"
          ]
        },
        "status": { "enum": ["resolved", "unresolved", "blocked"] },
        "proposal": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "authorsDigest",
                "coverageWaiverId",
                "fullyCovered",
                "gaps",
                "head",
                "proposalId",
                "reviewedAttemptId",
                "unattributed"
              ],
              "properties": {
                "authorsDigest": {
                  "anyOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                  ]
                },
                "coverageWaiverId": {
                  "anyOf": [{ "type": "null" }, { "type": "string" }]
                },
                "fullyCovered": { "type": "boolean" },
                "gaps": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["uncoveredEdits", "unresolvedSources"],
                    "properties": {
                      "uncoveredEdits": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "unresolvedSources": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    }
                  }
                },
                "head": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "proposalId": { "type": "string", "minLength": 1 },
                "reviewedAttemptId": {
                  "anyOf": [{ "type": "null" }, { "type": "string" }]
                },
                "unattributed": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          ]
        }
      }
    },
    "turnEndGuard": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "harness",
            "installCommand",
            "installed",
            "path"
          ],
          "properties": {
            "current": { "type": "boolean" },
            "harness": { "enum": ["claude-code", "codex"] },
            "installCommand": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "installed": { "type": "boolean" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
