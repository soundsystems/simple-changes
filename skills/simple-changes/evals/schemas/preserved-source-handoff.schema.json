{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/preserved-source-handoff.schema.json",
  "title": "Simple Changes preserved-source handoffs",
  "description": "Sidecar beside the loop lease for one recorded shipment outcome. Each handoff is a user-approved, independently reviewed decision that a dirty source checkout, detached or on a branch, which its original owner paused in place and the controller accepted, shipped through a committed copy of its exact bytes plus reviewed target entries, and stays preserved under that owner's claim. A `loop record-outcome` receipt carries each handoff on its unit as `preservedSourceHandoff`; the runtime moves it here so older clients can still read the lease.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "receiptDigest", "handoffs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
    "receiptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "handoffs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/handoff" }
    }
  },
  "$defs": {
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalReference",
        "approvalReason",
        "approvedAt",
        "approvedBy",
        "claimId",
        "copyRevision",
        "decision",
        "ownerAgentId",
        "pauseReceiptId",
        "paths",
        "preservation",
        "reviewReference",
        "reviewedAt",
        "reviewerAgentId",
        "runId",
        "sourceBranch",
        "sourceChangeDigest",
        "sourceHeadRevision",
        "sourceWorktree",
        "targetRevision",
        "unitId"
      ],
      "properties": {
        "approvalReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "approvalReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "approvedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "claimId": { "type": "string", "minLength": 1 },
        "copyRevision": { "$ref": "#/$defs/revision" },
        "decision": { "const": "reviewed-handoff" },
        "ownerAgentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pauseReceiptId": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sourceEntry", "copyEntry", "targetEntry"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sourceEntry": { "$ref": "#/$defs/entry" },
              "copyEntry": { "$ref": "#/$defs/entry" },
              "targetEntry": { "$ref": "#/$defs/entry" }
            }
          }
        },
        "preservation": { "const": "keep-source-in-place" },
        "reviewReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewerAgentId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
        "sourceBranch": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "sourceChangeDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceHeadRevision": { "$ref": "#/$defs/revision" },
        "sourceWorktree": { "type": "string", "minLength": 1 },
        "targetRevision": { "$ref": "#/$defs/revision" },
        "unitId": { "type": "string", "minLength": 1 }
      }
    },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "entry": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+:(blob|commit):[0-9a-f]+$"
        },
        { "type": "null" }
      ]
    }
  }
}
