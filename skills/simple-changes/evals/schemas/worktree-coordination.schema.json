{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/worktree-coordination.schema.json",
  "title": "Simple Changes worktree coordination state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "claims", "receipts", "events"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repositoryId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "receipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/pauseReceipt" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "active",
        "pause-requested",
        "paused",
        "adopted-preserved",
        "detach-requested",
        "detached",
        "attached",
        "resume-ready",
        "released",
        "stale",
        "blocked"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "adapter", "ownerRef"],
      "properties": {
        "agentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "ownerRef": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 512 },
            { "type": "null" }
          ]
        }
      }
    },
    "resumeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "targetRef", "targetSha", "createdAt"],
      "properties": {
        "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
        "targetRef": { "type": "string", "minLength": 1 },
        "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "claimId",
        "repositoryId",
        "commonGitDirectory",
        "path",
        "branch",
        "headSha",
        "changeDigest",
        "owner",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "claimId": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
        "repositoryId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "commonGitDirectory": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "branch": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "headSha": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            { "type": "null" }
          ]
        },
        "changeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "owner": { "$ref": "#/$defs/owner" },
        "state": { "$ref": "#/$defs/state" },
        "resumeTarget": { "$ref": "#/$defs/resumeTarget" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "pauseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "receiptId",
        "claimId",
        "requestingRunId",
        "path",
        "branch",
        "headSha",
        "changeDigest",
        "ownerAgentId",
        "disposition",
        "acknowledgedAt",
        "reason"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "receiptId": { "type": "string", "pattern": "^pause-[a-z0-9-]+$" },
        "claimId": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
        "requestingRunId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
        "path": { "type": "string", "minLength": 1 },
        "branch": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "headSha": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            { "type": "null" }
          ]
        },
        "changeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ownerAgentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "disposition": {
          "enum": ["preserve-in-place", "detach-clean-checkout"]
        },
        "acknowledgedAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "claimId", "actorAgentId", "state", "createdAt"],
      "properties": {
        "eventId": { "type": "string", "pattern": "^event-[a-z0-9-]+$" },
        "claimId": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
        "actorAgentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "$ref": "#/$defs/state" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
