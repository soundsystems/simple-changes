{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/release-delivery-receipt.schema.json",
  "title": "Simple Changes composite release delivery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transactionId",
    "releaseSetId",
    "releaseTrain",
    "version",
    "decisionDigest",
    "inputTargetRevision",
    "reconciliationHeadRevision",
    "finalizedTargetRevision",
    "deploymentReceiptId",
    "deployedRevision",
    "status",
    "reasonCode",
    "requiredAction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transactionId": { "type": "string", "minLength": 1 },
    "releaseSetId": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "releaseTrain": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "decisionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inputTargetRevision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "reconciliationHeadRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "finalizedTargetRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "deploymentReceiptId": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "deployedRevision": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        { "type": "null" }
      ]
    },
    "status": { "enum": ["complete", "partial", "blocked"] },
    "reasonCode": {
      "anyOf": [
        {
          "enum": [
            "deployment-revision-mismatch",
            "provider-observation-incomplete"
          ]
        },
        { "type": "null" }
      ]
    },
    "requiredAction": {
      "anyOf": [
        { "enum": ["inspect-deployment", "retry-observation"] },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "deploymentReceiptId": { "type": "string", "minLength": 1 },
          "deployedRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "reasonCode": { "type": "null" },
          "requiredAction": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reasonCode": { "const": "deployment-revision-mismatch" }
        },
        "required": ["reasonCode"]
      },
      "then": {
        "properties": { "requiredAction": { "const": "inspect-deployment" } }
      }
    },
    {
      "if": {
        "properties": {
          "reasonCode": { "const": "provider-observation-incomplete" }
        },
        "required": ["reasonCode"]
      },
      "then": {
        "properties": { "requiredAction": { "const": "retry-observation" } }
      }
    }
  ]
}
