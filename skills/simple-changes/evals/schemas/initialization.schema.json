{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/initialization.schema.json",
  "title": "Simple Changes initialization status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "changelogCoordination",
    "handoffAction",
    "handoffTiming",
    "writeCapable",
    "mutationAllowed",
    "onboardingRequired",
    "policySource",
    "policyPath",
    "inferredDefaultFinish",
    "readinessConfirmed",
    "resolvedMode",
    "reason"
  ],
  "properties": {
    "changelogCoordination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevant",
        "capabilityAvailable",
        "releaseSurfaces",
        "providers"
      ],
      "properties": {
        "relevant": { "type": "boolean" },
        "capabilityAvailable": { "type": "boolean" },
        "releaseSurfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mode": {
      "enum": [
        "preview",
        "sync",
        "queue",
        "sweep",
        "integrate",
        "ship",
        "reconcile",
        "resume",
        "pause",
        "handoff"
      ]
    },
    "handoffAction": {
      "enum": [
        "not-applicable",
        "confirm-readiness",
        "wait-for-user",
        "proceed"
      ]
    },
    "handoffTiming": {
      "anyOf": [
        { "enum": ["confirm-ready", "automatic", "user-signaled"] },
        { "type": "null" }
      ]
    },
    "writeCapable": { "type": "boolean" },
    "mutationAllowed": { "type": "boolean" },
    "onboardingRequired": { "type": "boolean" },
    "policySource": { "enum": ["default", "user", "repository"] },
    "policyPath": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "inferredDefaultFinish": {
      "anyOf": [
        { "enum": ["open-change-request", "integrate", "ship"] },
        { "type": "null" }
      ]
    },
    "readinessConfirmed": { "type": "boolean" },
    "resolvedMode": {
      "anyOf": [
        {
          "enum": [
            "preview",
            "sync",
            "queue",
            "sweep",
            "integrate",
            "ship",
            "reconcile",
            "resume",
            "pause"
          ]
        },
        { "type": "null" }
      ]
    },
    "reason": { "type": "string", "minLength": 1 }
  }
}
