{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/replacement-lineage-receipt.schema.json",
  "title": "Simple Changes reviewed replacement lineage receipt",
  "description": "Input to prune and worktree cleanup through --lineage-receipt. It names one clean local source checkout whose unique commits shipped through different replacement commits already in the target, the independent review that mapped every unique source commit to its replacements, and the user's later approval to remove the checkout. Every fact it states is checked against live Git before anything is written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "source",
    "targetRef",
    "targetRevision",
    "commits",
    "review",
    "approval"
  ],
  "properties": {
    "kind": { "const": "replacement-lineage-receipt" },
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "branch",
        "headRevision",
        "changeDigest",
        "authorAgentId"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "branch": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "headRevision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "changeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authorAgentId": { "type": "string", "minLength": 1 }
      }
    },
    "targetRef": { "type": "string", "minLength": 1 },
    "targetRevision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceCommit", "replacementCommits"],
        "properties": {
          "sourceCommit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "replacementCommits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerAgentId",
        "reviewReference",
        "reviewedAt",
        "decision"
      ],
      "properties": {
        "reviewerAgentId": { "type": "string", "minLength": 1 },
        "reviewReference": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "decision": { "const": "replaced-in-target" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "approvalReference", "approvedAt", "reason"],
      "properties": {
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvalReference": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
