{
  "name": "simple-changes",
  "version": "0.12.18",
  "description": "Forge-agnostic skill for focused, verified change proposals.",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/soundsystems/simple-changes.git"
  },
  "homepage": "https://gitlab.com/soundsystems/simple-changes",
  "bugs": {
    "url": "https://gitlab.com/soundsystems/simple-changes/-/issues"
  },
  "keywords": [
    "git",
    "workflow",
    "agent-skill",
    "merge-request",
    "release-automation"
  ],
  "bin": {
    "simple-changes": "./skills/simple-changes/scripts/simple-changes.ts"
  },
  "files": [
    "skills/simple-changes",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test && bun run eval",
    "behavior": "bun tooling/simple-changes/behavior-eval.ts",
    "eval": "bun tooling/simple-changes/eval.ts",
    "format": "bunx ultracite fix",
    "lint": "bunx ultracite check",
    "simple-changes": "bun skills/simple-changes/scripts/simple-changes.ts",
    "test": "bun test tooling/simple-changes/tests && bun tooling/publish-skill/scripts/test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.2",
    "ultracite": "^7.9.4"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
