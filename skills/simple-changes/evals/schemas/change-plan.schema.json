{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/change-plan.schema.json",
  "title": "Simple Changes change plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "request",
    "mode",
    "repositoryRoot",
    "baselineDigest",
    "units",
    "preserved",
    "exclusions",
    "questions",
    "warnings",
    "mutationsAllowed",
    "mutationCount"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "request": { "type": "string" },
    "mode": {
      "enum": [
        "preview",
        "sync",
        "queue",
        "sweep",
        "integrate",
        "ship",
        "reconcile",
        "resume",
        "pause"
      ]
    },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "baselineDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "units": {
      "type": "array",
      "items": { "$ref": "#/$defs/unit" }
    },
    "preserved": {
      "type": "array",
      "items": { "$ref": "#/$defs/preserved" }
    },
    "exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "mutationsAllowed": { "type": "boolean" },
    "mutationCount": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "sourceWorktree",
        "paths",
        "dependencies",
        "checks",
        "releaseImpact",
        "requiredAuthority",
        "operations",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "sourceWorktree": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "releaseImpact": {
          "enum": ["none", "patch", "minor", "major", "unknown"]
        },
        "requiredAuthority": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "local-write",
              "local-sync",
              "proposal-write",
              "merge",
              "remote-branch-delete",
              "preview-deploy",
              "production-deploy",
              "remote-data-write",
              "secret-env-write",
              "dns-write",
              "store-release",
              "history-rewrite"
            ]
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "fetch-target",
              "fast-forward-target",
              "merge-target",
              "branch",
              "commit",
              "push",
              "open-proposal",
              "update-proposal",
              "merge",
              "deploy-preview",
              "deploy-production",
              "promote-deployment",
              "reconcile-managed-targets",
              "reconcile-remote-branches",
              "audit-migration",
              "apply-migration",
              "cleanup"
            ]
          }
        },
        "status": { "enum": ["ready", "blocked", "paused"] }
      }
    },
    "preserved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktreePath", "paths", "classification", "reason"],
      "properties": {
        "worktreePath": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "classification": {
          "enum": [
            "concurrent-arrival",
            "actively-changing",
            "paused",
            "unsafe"
          ]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "worktreePath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
