{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/queued-work.schema.json",
  "title": "Simple Changes queued work",
  "description": "Record a closed Queue or Sweep run leaves beside the loop state at `queued-work/<run-id>.json`: each branch it pushed for review and did not merge. A later `loop start` or `loop status` reads it to name uncommitted primary-checkout content that is already queued, so the same bytes are not proposed again as new work without saying so. Kept in its own file so older runtimes never meet it; `loop start` forgets a record once its branches are merged or gone, or after 90 days.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "mode",
    "closedAt",
    "primaryCheckout",
    "targetRef",
    "units"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "queued-work" },
    "runId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["queue", "sweep"] },
    "closedAt": { "type": "string", "minLength": 1 },
    "primaryCheckout": { "type": "string", "minLength": 1 },
    "targetRef": { "type": "string", "minLength": 1 },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "headSha",
        "primaryCopies",
        "proposalIds",
        "remote",
        "remoteBranch",
        "withoutProposal",
        "worktree"
      ],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "headSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "primaryCopies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "proposalIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "remote": { "type": "string", "minLength": 1 },
        "remoteBranch": { "type": "string", "minLength": 1 },
        "withoutProposal": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "worktree": { "type": "string", "minLength": 1 }
      }
    }
  }
}
