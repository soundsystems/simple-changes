{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/preserved-source-override.schema.json",
  "title": "Simple Changes preserved-source overrides",
  "description": "Sidecar beside the loop lease for one recorded shipment outcome. Each override is a user-approved, independently reviewed decision that a claimed author's dirty checkout shipped in a semantically equivalent form and stays preserved. A `loop record-outcome` receipt carries each override on its unit as `preservedSourceOverride`; the runtime moves it here so older clients can still read the lease.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "receiptDigest", "overrides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
    "receiptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "overrides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/override" }
    }
  },
  "$defs": {
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalReference",
        "approvalReason",
        "approvedAt",
        "approvedBy",
        "claimId",
        "decision",
        "paths",
        "reviewReference",
        "reviewedAt",
        "reviewerAgentId",
        "runId",
        "sourceBranch",
        "sourceChangeDigest",
        "sourceHeadRevision",
        "sourceWorktree",
        "targetRevision",
        "unitId"
      ],
      "properties": {
        "approvalReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "approvalReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "approvedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "claimId": { "type": "string", "minLength": 1 },
        "decision": { "const": "semantically-equivalent" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sourceEntry", "targetEntry"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sourceEntry": { "$ref": "#/$defs/entry" },
              "targetEntry": { "$ref": "#/$defs/entry" }
            }
          }
        },
        "reviewReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewerAgentId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
        "sourceBranch": { "type": "string", "minLength": 1 },
        "sourceChangeDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceHeadRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "sourceWorktree": { "type": "string", "minLength": 1 },
        "targetRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "unitId": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+:(blob|commit):[0-9a-f]+$"
        },
        { "type": "null" }
      ]
    }
  }
}
