{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/remote-branch-supersession.schema.json",
  "title": "Simple Changes remote branch supersession approvals",
  "description": "Sidecar beside the loop lease for one remote-branch reconciliation receipt. Each approval lets a deleted closed-unmerged or no-proposal branch whose head the target does not contain record a deleted-proven-obsolete disposition, because the named user judged it superseded by named target commits. Kept out of the lease so older clients can still read the lease.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "receiptDigest", "supersessions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "supersessions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/supersession" }
    }
  },
  "$defs": {
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "initialHeadRevision",
        "replacementRevisions",
        "approvedBy",
        "reason"
      ],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "initialHeadRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "replacementRevisions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
        },
        "approvedBy": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
