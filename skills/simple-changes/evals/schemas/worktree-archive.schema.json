{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/worktree-archive.schema.json",
  "title": "Simple Changes worktree archive manifest",
  "description": "The manifest.json of one archive under the Git common directory's simple-changes/archives/<archive id>/ folder. It records a reviewed checkout folder (checkout/) and its private Git directory (git/) entry by entry, the pins that keep the objects they name, the branch configuration restore recreates, and the retention terms the user approved. It is new state in its own file, so older runtimes never read it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "archiveId",
    "createdAt",
    "expiresAt",
    "retention",
    "commonGitDirectory",
    "repositoryId",
    "source",
    "privateGitDirectory",
    "receiptDigest",
    "removalId",
    "targetRef",
    "replacementCommits",
    "branchConfig",
    "pinRefs",
    "checkout",
    "gitDirectory"
  ],
  "properties": {
    "kind": { "const": "worktree-archive" },
    "schemaVersion": { "const": 1 },
    "archiveId": {
      "type": "string",
      "pattern": "^archive-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}-[0-9a-f]{8}$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "maxTotalBytes"],
      "properties": {
        "days": { "type": "integer", "minimum": 1 },
        "maxTotalBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "commonGitDirectory": { "type": "string", "minLength": 1 },
    "repositoryId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "headSha", "changeDigest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "branch": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "headSha": { "$ref": "#/$defs/objectId" },
        "changeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "privateGitDirectory": { "type": "string", "minLength": 1 },
    "receiptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "removalId": {
      "type": "string",
      "pattern": "^lineage-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "targetRef": { "type": "string", "minLength": 1, "pattern": "^[^-]" },
    "replacementCommits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/objectId" }
    },
    "branchConfig": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "pattern": "^branch\\..+\\.[^.]+$" },
          "value": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        }
      }
    },
    "pinRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "object"],
        "properties": {
          "ref": { "type": "string", "pattern": "^refs/[^\\u0000]+$" },
          "object": { "$ref": "#/$defs/objectId" }
        }
      }
    },
    "checkout": { "$ref": "#/$defs/tree" },
    "gitDirectory": { "$ref": "#/$defs/tree" }
  },
  "$defs": {
    "objectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "count", "entries"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "mode", "size", "sha256", "linkTarget"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!\\.\\.?(?:/|$))[^/\\u0000]+(?:/(?!\\.\\.?(?:/|$))[^/\\u0000]+)*$"
        },
        "type": { "enum": ["file", "directory", "symlink"] },
        "mode": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "linkTarget": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "file" } }
          },
          "then": {
            "properties": {
              "sha256": { "type": "string" },
              "linkTarget": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "directory" } }
          },
          "then": {
            "properties": {
              "sha256": { "type": "null" },
              "linkTarget": { "type": "null" },
              "size": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "symlink" } }
          },
          "then": {
            "properties": {
              "sha256": { "type": "null" },
              "linkTarget": { "type": "string" },
              "mode": { "const": 0 },
              "size": { "const": 0 }
            }
          }
        }
      ]
    }
  }
}
