{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/initialization.schema.json",
  "title": "Simple Changes initialization status",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "guidanceQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choices", "id", "question", "reason", "setting"],
      "properties": {
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "label", "recommended", "value"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "recommended": { "type": "boolean" },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        },
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "setting": { "type": "string", "minLength": 1 }
      }
    }
  },
  "required": [
    "mode",
    "changelogRequired",
    "changelogCoordination",
    "firstUseWalkthroughAvailable",
    "gitPushAuthorization",
    "guidanceUpdate",
    "handoffAction",
    "handoffClaimRelease",
    "handoffTiming",
    "writeCapable",
    "mutationAllowed",
    "onboardingRequired",
    "policySource",
    "policyPath",
    "policyTrust",
    "inferredDefaultFinish",
    "migrationHandling",
    "migrationTargets",
    "readinessConfirmed",
    "preLoopActionRequired",
    "resolvedMode",
    "shippingMode",
    "reason"
  ],
  "properties": {
    "gitPushAuthorization": {
      "enum": ["configure-harness", "ask", "never"]
    },
    "guidanceUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionDescriptions",
        "actions",
        "changelogHandoff",
        "changes",
        "currentVersion",
        "headline",
        "presentationOrder",
        "recommendedChanges",
        "releaseNotes",
        "recommendedAction",
        "requiredAnswers",
        "status",
        "storedDisposition",
        "storedVersion",
        "summaryBullets",
        "walkthroughQuestion"
      ],
      "properties": {
        "actionDescriptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review-settings",
            "expanded-walkthrough",
            "keep-current-settings",
            "defer",
            "view-release-notes",
            "review-with-simple-changelogs"
          ],
          "properties": {
            "review-settings": { "type": "string", "minLength": 1 },
            "expanded-walkthrough": { "type": "string", "minLength": 1 },
            "keep-current-settings": { "type": "string", "minLength": 1 },
            "defer": { "type": "string", "minLength": 1 },
            "view-release-notes": { "type": "string", "minLength": 1 },
            "review-with-simple-changelogs": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "review-settings",
              "expanded-walkthrough",
              "keep-current-settings",
              "defer",
              "view-release-notes",
              "review-with-simple-changelogs"
            ]
          }
        },
        "changelogHandoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "owner", "reason"],
          "properties": {
            "available": { "type": "boolean" },
            "owner": {
              "anyOf": [{ "const": "simple-changelogs" }, { "type": "null" }]
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "summary", "version"],
            "properties": {
              "kind": { "enum": ["behavior", "onboarding", "integration"] },
              "summary": { "type": "string", "minLength": 1 },
              "version": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "currentVersion": { "type": "integer", "minimum": 1 },
        "headline": {
          "const": "**Simple Changes has recently been updated.**"
        },
        "presentationOrder": {
          "type": "array",
          "const": [
            "required-answers",
            "recommended-changes",
            "summary",
            "actions"
          ]
        },
        "recommendedChanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/guidanceQuestion" }
        },
        "releaseNotes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "command", "label"],
          "properties": {
            "available": { "const": true },
            "command": { "const": "simple-changes release-notes" },
            "label": {
              "const": "View detailed Simple Changes release notes"
            }
          }
        },
        "recommendedAction": {
          "anyOf": [
            {
              "enum": [
                "review-settings",
                "expanded-walkthrough",
                "keep-current-settings",
                "defer",
                "view-release-notes",
                "review-with-simple-changelogs"
              ]
            },
            { "type": "null" }
          ]
        },
        "requiredAnswers": {
          "type": "array",
          "items": { "$ref": "#/$defs/guidanceQuestion" }
        },
        "status": { "enum": ["current", "update-available"] },
        "storedDisposition": {
          "anyOf": [
            { "enum": ["accepted", "reviewed", "deferred"] },
            { "type": "null" }
          ]
        },
        "storedVersion": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "summaryBullets": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "walkthroughQuestion": {
          "const": "How would you like to continue?"
        }
      }
    },
    "changelogCoordination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevant",
        "capabilityAvailable",
        "capabilityHelpers",
        "capabilityStatus",
        "guidanceUpdate",
        "releaseSurfaces",
        "providers",
        "providerEvidence"
      ],
      "properties": {
        "relevant": { "type": "boolean" },
        "capabilityAvailable": { "type": "boolean" },
        "providerEvidence": { "enum": ["marker", "inferred", "none"] },
        "capabilityHelpers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilityStatus": { "enum": ["absent", "unverified"] },
        "guidanceUpdate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actions",
            "detailsPath",
            "headline",
            "installedVersion",
            "owner",
            "policyPath",
            "provider",
            "status",
            "storedVersion",
            "summaryBullets",
            "walkthroughQuestion"
          ],
          "properties": {
            "actions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["walkthrough", "continue", "view-release-notes"]
              }
            },
            "detailsPath": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "headline": {
              "const": "**Simple Changelogs has recently been updated.**"
            },
            "installedVersion": {
              "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
            },
            "owner": {
              "anyOf": [{ "const": "simple-changelogs" }, { "type": "null" }]
            },
            "policyPath": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "provider": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "status": {
              "enum": [
                "absent",
                "unconfigured",
                "current",
                "update-available",
                "unknown"
              ]
            },
            "storedVersion": {
              "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
            },
            "summaryBullets": {
              "type": "array",
              "maxItems": 3,
              "items": { "type": "string", "minLength": 1 }
            },
            "walkthroughQuestion": {
              "const": "Would you like me to walk you through the recent Simple Changelogs updates before I continue?"
            }
          }
        },
        "releaseSurfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mode": {
      "enum": [
        "preview",
        "sync",
        "queue",
        "sweep",
        "integrate",
        "ship",
        "reconcile",
        "resume",
        "pause",
        "handoff"
      ]
    },
    "handoffAction": {
      "enum": [
        "not-applicable",
        "confirm-readiness",
        "wait-for-user",
        "proceed"
      ]
    },
    "handoffClaimRelease": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimId", "path"],
          "properties": {
            "claimId": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "handoffTiming": {
      "anyOf": [
        { "enum": ["confirm-ready", "automatic", "user-signaled"] },
        { "type": "null" }
      ]
    },
    "writeCapable": { "type": "boolean" },
    "firstUseWalkthroughAvailable": { "type": "boolean" },
    "changelogRequired": { "type": "boolean" },
    "mutationAllowed": { "type": "boolean" },
    "onboardingRequired": { "type": "boolean" },
    "policySource": { "enum": ["default", "user", "repository"] },
    "policyPath": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "policyTrust": { "enum": ["not-required", "trusted", "untrusted"] },
    "inferredDefaultFinish": {
      "anyOf": [
        { "enum": ["open-change-request", "integrate", "ship"] },
        { "type": "null" }
      ]
    },
    "migrationHandling": {
      "enum": [
        "ask-after-review",
        "auto-apply-reviewed-routine",
        "auto-apply-reviewed",
        "never"
      ]
    },
    "migrationTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "project", "environment"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 }
        }
      }
    },
    "readinessConfirmed": { "type": "boolean" },
    "preLoopActionRequired": { "type": "boolean" },
    "resolvedMode": {
      "anyOf": [
        {
          "enum": [
            "preview",
            "sync",
            "queue",
            "sweep",
            "integrate",
            "ship",
            "reconcile",
            "resume",
            "pause"
          ]
        },
        { "type": "null" }
      ]
    },
    "shippingMode": {
      "enum": ["standard", "expedited", "break-glass"]
    },
    "reason": { "type": "string", "minLength": 1 }
  }
}
