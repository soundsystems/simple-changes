{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/release-consistency.schema.json",
  "title": "Release consistency report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "valid", "versions", "issues"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "valid": { "type": "boolean" },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "version", "date"],
        "properties": {
          "role": {
            "enum": [
              "customer-history",
              "developer-history",
              "package",
              "packaged-history",
              "skill-metadata"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
