{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/run-state.schema.json",
  "title": "Simple Changes resumable run state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "mode",
    "createdAt",
    "updatedAt",
    "baselineDigest",
    "unitStates",
    "approvals",
    "receipts",
    "concurrentArrivals",
    "blockers",
    "resumeBoundary",
    "cleanupTargets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": [
        "sync",
        "queue",
        "sweep",
        "integrate",
        "ship",
        "reconcile",
        "resume"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "baselineDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "unitStates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "status", "headRevision", "fingerprint"],
        "properties": {
          "unitId": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "planned",
              "packaged",
              "proposed",
              "reviewed",
              "merged",
              "deployed",
              "blocked"
            ]
          },
          "headRevision": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "reviewer", "revision", "verdict", "observedAt"],
        "properties": {
          "unitId": { "type": "string", "minLength": 1 },
          "reviewer": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["approved", "changes-requested"] },
          "observedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": { "$ref": "provider-receipt.schema.json" }
    },
    "concurrentArrivals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "resumeBoundary": { "type": "string", "minLength": 1 },
    "cleanupTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "identity", "proof"],
        "properties": {
          "kind": { "enum": ["branch", "worktree", "generated"] },
          "identity": { "type": "string", "minLength": 1 },
          "proof": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coordinatedOnboarding": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transactionId", "status", "owners"],
          "properties": {
            "transactionId": { "type": "string", "minLength": 1 },
            "status": { "enum": ["pending", "completed", "partial"] },
            "owners": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "destination",
                  "policyDigest",
                  "writeReceiptDigest",
                  "status"
                ],
                "properties": {
                  "owner": { "enum": ["simple-changes", "simple-changelogs"] },
                  "destination": { "type": "string", "minLength": 1 },
                  "policyDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "writeReceiptDigest": {
                    "anyOf": [
                      { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      { "type": "null" }
                    ]
                  },
                  "status": { "enum": ["pending", "completed", "failed"] }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "releaseDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transactionId",
          "releaseSetId",
          "attempt",
          "phase",
          "releaseTrain",
          "boundary",
          "inputTargetRevision",
          "reconciliationHeadRevision",
          "finalizedTargetRevision",
          "deployedRevision",
          "currentVersion",
          "suggestedVersion",
          "selectedVersion",
          "status",
          "reasonCode",
          "requiredAction",
          "approval",
          "requestVersion",
          "receiptVersion",
          "requestSchemaDigest",
          "receiptSchemaDigest",
          "effectivePolicyDigest",
          "decisionDigest",
          "priorReceiptDigest",
          "lastCompletedBoundary",
          "compositeReceipt"
        ],
        "properties": {
          "transactionId": { "type": "string", "minLength": 1 },
          "releaseSetId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "attempt": { "type": "integer", "minimum": 1 },
          "phase": { "enum": ["classify", "prepare", "verify"] },
          "releaseTrain": { "type": "string", "minLength": 1 },
          "boundary": {
            "enum": [
              "release-bearing-merge",
              "web-production",
              "package-publication",
              "store-release",
              "other-public-release",
              "none"
            ]
          },
          "inputTargetRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "reconciliationHeadRevision": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
              { "type": "null" }
            ]
          },
          "finalizedTargetRevision": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
              { "type": "null" }
            ]
          },
          "deployedRevision": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
              { "type": "null" }
            ]
          },
          "currentVersion": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "suggestedVersion": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "selectedVersion": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "status": {
            "enum": [
              "decision-required",
              "prepared",
              "verified",
              "not-applicable",
              "blocked"
            ]
          },
          "reasonCode": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "requiredAction": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["versionAuthorized", "productionAuthorized"],
            "properties": {
              "versionAuthorized": { "type": "boolean" },
              "productionAuthorized": { "type": "boolean" }
            }
          },
          "requestVersion": { "const": 1 },
          "receiptVersion": { "enum": [1, 2] },
          "requestSchemaDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "receiptSchemaDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "effectivePolicyDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decisionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "priorReceiptDigest": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              { "type": "null" }
            ]
          },
          "lastCompletedBoundary": { "type": "string", "minLength": 1 },
          "compositeReceipt": {
            "anyOf": [
              { "$ref": "release-delivery-receipt.schema.json" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "emergencyShipping": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "status",
            "evidence",
            "breakGlassAuthorized",
            "authoritySource",
            "productionAuthorized",
            "candidateRevision",
            "previousProductionRevision",
            "deployedRevision",
            "canonicalRevision",
            "candidateArtifactId",
            "deployedArtifactId",
            "canonicalArtifactId",
            "rollbackSupported",
            "rollbackAnchorRecorded",
            "focusedChecksPassed",
            "candidateVerifiedHealthy",
            "independentReview",
            "mergeCompleted",
            "changelogReconciled",
            "artifactEquivalenceProven",
            "redeployDecision",
            "finalVerificationPassed",
            "cleanupCompleted"
          ],
          "properties": {
            "mode": { "enum": ["expedited", "break-glass"] },
            "status": {
              "enum": [
                "ready",
                "live-unreconciled",
                "live-unreviewed",
                "reviewed",
                "canonicalized",
                "rollback-required",
                "complete",
                "blocked"
              ]
            },
            "evidence": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "urgency-language",
                  "active-user-impact",
                  "tested-ready-for-production",
                  "deploy-before-review"
                ]
              }
            },
            "breakGlassAuthorized": { "type": "boolean" },
            "authoritySource": {
              "anyOf": [
                {
                  "enum": [
                    "advanced-policy",
                    "explicit-current-request",
                    "confirmed-run-only"
                  ]
                },
                { "type": "null" }
              ]
            },
            "productionAuthorized": { "type": "boolean" },
            "candidateRevision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            "previousProductionRevision": {
              "anyOf": [
                { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
                { "type": "null" }
              ]
            },
            "deployedRevision": {
              "anyOf": [
                { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
                { "type": "null" }
              ]
            },
            "canonicalRevision": {
              "anyOf": [
                { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
                { "type": "null" }
              ]
            },
            "candidateArtifactId": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "deployedArtifactId": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "canonicalArtifactId": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "rollbackSupported": { "type": "boolean" },
            "rollbackAnchorRecorded": { "type": "boolean" },
            "focusedChecksPassed": { "type": "boolean" },
            "candidateVerifiedHealthy": { "type": "boolean" },
            "independentReview": {
              "enum": ["pending", "approved", "changes-requested"]
            },
            "mergeCompleted": { "type": "boolean" },
            "changelogReconciled": { "type": "boolean" },
            "artifactEquivalenceProven": { "type": "boolean" },
            "redeployDecision": {
              "enum": [
                "pending",
                "not-required",
                "verify-equivalent-artifact",
                "deploy-canonical"
              ]
            },
            "finalVerificationPassed": { "type": "boolean" },
            "cleanupCompleted": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "breakGlassAuthorized": { "const": true }
                },
                "required": ["breakGlassAuthorized"]
              },
              "then": {
                "properties": {
                  "authoritySource": {
                    "enum": [
                      "advanced-policy",
                      "explicit-current-request",
                      "confirmed-run-only"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": { "status": { "const": "complete" } },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "candidateVerifiedHealthy": { "const": true },
                  "canonicalRevision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40,64}$"
                  },
                  "changelogReconciled": { "const": true },
                  "cleanupCompleted": { "const": true },
                  "deployedRevision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40,64}$"
                  },
                  "finalVerificationPassed": { "const": true },
                  "focusedChecksPassed": { "const": true },
                  "independentReview": { "const": "approved" },
                  "mergeCompleted": { "const": true },
                  "productionAuthorized": { "const": true }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": { "const": "break-glass" },
                  "status": { "const": "complete" }
                },
                "required": ["mode", "status"]
              },
              "then": {
                "properties": {
                  "breakGlassAuthorized": { "const": true },
                  "rollbackAnchorRecorded": { "const": true },
                  "rollbackSupported": { "const": true }
                }
              }
            }
          ]
        },
        { "type": "null" }
      ]
    }
  }
}
