{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/runner-response.schema.json",
  "title": "Portable behavior runner response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "plan", "report", "errors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "plan": { "type": "null" },
    "report": { "type": "string" },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
