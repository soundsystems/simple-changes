{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/loop-lease.schema.json",
  "title": "Simple Changes active integration-loop lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "mode",
    "ownerAgentId",
    "createdAt",
    "updatedAt",
    "baselineDigest",
    "commonGitDirectory",
    "primaryCheckout",
    "targetRef",
    "targetRevision",
    "preparations",
    "worktrees",
    "overrides"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
    "mode": {
      "enum": ["queue", "sweep", "integrate", "ship", "reconcile", "resume"]
    },
    "ownerAgentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "baselineDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commonGitDirectory": { "type": "string", "minLength": 1 },
    "concurrentWork": { "enum": ["allow-claimed", "strict"] },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "acquiredAt",
        "relinquishedAt",
        "reason",
        "handoffs"
      ],
      "properties": {
        "status": { "enum": ["active", "relinquished"] },
        "acquiredAt": { "type": "string", "format": "date-time" },
        "relinquishedAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "reason": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 500 },
            { "type": "null" }
          ]
        },
        "handoffs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "fromAgentId",
              "toAgentId",
              "approvedBy",
              "reason",
              "at"
            ],
            "properties": {
              "kind": { "enum": ["resume", "takeover"] },
              "fromAgentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "toAgentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "approvedBy": {
                "anyOf": [
                  { "type": "string", "minLength": 1, "maxLength": 128 },
                  { "type": "null" }
                ]
              },
              "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
              "at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "emergencyShipping": { "$ref": "emergency-shipping.schema.json" },
    "primaryCheckout": { "type": "string", "minLength": 1 },
    "openingBranches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
        }
      }
    },
    "openingRemoteInventory": {
      "$ref": "remote-branch-reconciliation.schema.json"
    },
    "remoteBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "provider", "fetchUrls", "pushUrls"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "fetchUrls": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "pushUrls": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "remoteBranchReconciliation": {
      "$ref": "remote-branch-reconciliation.schema.json"
    },
    "shipmentScopeRequired": { "type": "boolean" },
    "shipmentScopeFrozenAt": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "shipmentScopeHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["planDigest", "recordedAt", "supersededAt"],
        "properties": {
          "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "recordedAt": { "type": "string", "format": "date-time" },
          "supersededAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "shipmentScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openingChanges", "plan", "planDigest", "recordedAt"],
      "properties": {
        "openingChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["originalPath", "path", "sourceEntry", "worktreePath"],
            "properties": {
              "originalPath": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "path": { "type": "string", "minLength": 1 },
              "sourceEntry": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d+:(blob|commit):[0-9a-f]+$"
                  },
                  { "type": "null" }
                ]
              },
              "worktreePath": { "type": "string", "minLength": 1 }
            }
          }
        },
        "plan": { "$ref": "change-plan.schema.json" },
        "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "shipmentOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "receiptDigest", "recordedAt"],
      "properties": {
        "receipt": { "$ref": "shipment-outcome.schema.json" },
        "receiptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "targetRef": { "type": "string", "minLength": 1 },
    "targetRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "preparations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agentId",
          "baseRevision",
          "branch",
          "createdAt",
          "path",
          "purpose"
        ],
        "properties": {
          "agentId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "baseRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "branch": { "type": "string", "minLength": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "worktrees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "branch",
          "baselineHeadSha",
          "baselineChangeDigest",
          "role",
          "agentId",
          "mutationAllowed",
          "createdByRun"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "branch": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "baselineHeadSha": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
              { "type": "null" }
            ]
          },
          "baselineChangeDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "controller",
              "author",
              "concurrent-author",
              "preserved",
              "retained"
            ]
          },
          "agentId": {
            "anyOf": [
              { "type": "string", "minLength": 1, "maxLength": 128 },
              { "type": "null" }
            ]
          },
          "mutationAllowed": { "type": "boolean" },
          "createdByRun": { "type": "boolean" },
          "claimId": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
          "pauseReceiptId": {
            "type": "string",
            "pattern": "^pause-[a-z0-9-]+$"
          },
          "coordinationState": {
            "enum": ["adopted-preserved", "resume-ready"]
          },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approvedBy", "reason", "createdAt"],
            "properties": {
              "approvedBy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "role": { "const": "retained" } },
              "required": ["role"]
            },
            "then": { "required": ["retention"] }
          }
        ]
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "branch",
          "headSha",
          "changeDigest",
          "targetRef",
          "targetRevision",
          "uniqueCommitCount",
          "outcome",
          "approvedBy",
          "reason",
          "createdAt"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "branch": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
          "changeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "status": { "enum": ["intended", "completed"] },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "targetRef": { "type": "string", "minLength": 1 },
          "targetRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "uniqueCommitCount": { "const": 0 },
          "outcome": { "const": "remove-after-audit" },
          "approvedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "headSha",
          "changeDigest",
          "approvedBy",
          "reason",
          "createdAt"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "headSha": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
              { "type": "null" }
            ]
          },
          "changeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "approvedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
