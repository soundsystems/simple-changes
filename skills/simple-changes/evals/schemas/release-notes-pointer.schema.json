{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/release-notes-pointer.schema.json",
  "title": "Pointer to release notes older than the packaged window",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "version",
    "date",
    "guidance",
    "repository",
    "anchor",
    "url",
    "packaged",
    "guidanceNotice"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "outside-packaged-window" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "guidance": { "type": "integer", "minimum": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "anchor": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "packaged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["newest", "oldest"],
      "properties": {
        "newest": { "type": "string", "minLength": 1 },
        "oldest": { "type": "string", "minLength": 1 }
      }
    },
    "guidanceNotice": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["guidance", "summaries"],
        "properties": {
          "guidance": { "type": "integer", "minimum": 1 },
          "summaries": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
