{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-changes.dev/schemas/managed-worktree-directories.schema.json",
  "title": "Simple Changes managed worktree directories it created",
  "description": "Each managed .simple-changes-worktrees directory prepare-agent created for this repository, bound to the device and inode it had then and to the token in the .simple-changes-directory marker it wrote inside. Cleanup removes a managed directory only when it matches a record here and holds nothing but that marker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "directories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "directories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "device", "inode", "token", "createdAt", "runId"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "device": { "type": "string", "pattern": "^[0-9]+$" },
          "inode": { "type": "string", "pattern": "^[0-9]+$" },
          "token": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" }
        }
      }
    }
  }
}
