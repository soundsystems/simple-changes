{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "!**/node_modules",
      "!**/coverage",
      "!**/dist",
      "!.claude/worktrees",
      // Vendored byte-identically by Simple Changelogs, so shipped minified:
      // JSON.stringify(JSON.parse(text)) + "\n".
      "!skills/simple-changes/evals/schemas/changelog-request.schema.json",
      "!skills/simple-changes/evals/schemas/changelog-receipt.schema.json"
    ]
  }
}
